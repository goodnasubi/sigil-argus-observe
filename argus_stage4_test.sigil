module argus_stage4_test
  targets server
  trust none

use argus_receive.default_config;
use argus_receive.listen_on;
use argus_receive.open_hub;
use argus_receive.serve;
use argus_receive.share_hub;
use argus_receive.with_limits;
use argus_receive.with_listen;
use argus_receive.with_query_limits;
use argus_receive.with_rate_limit;
use argus_receive.with_retention;
use argus_receive.with_test_clock;

// Stage 4 verification:
// 1. Disk capacity limit and FIFO rotation (drop oldest logs first, prioritize continuous operation).
// 2. Data retention expiration pruning (logs exceeding retention period deleted).
// 3. High-frequency rate limiting for HTTP (/ingest -> 429 Too Many Requests) and recovery after window.
// 4. High-frequency rate limiting for raw TCP NDJSON (ERR rate_limited) and recovery after window.
// 5. Load boundaries: scan_limit reaching complete:false, query_max clamping, 413, 431, and 64 KB line limits.

struct Reply {
  status: Int,
  body: String,
}

fn has(text: &String, needle: &String) -> Bool
  intent "Substring test."
  requires none
  ensures none
  effects none
{
  let hay = text.as_bytes();
  let want = needle.as_bytes();
  let mut i = 0;
  while i + want.byte_len() <= hay.byte_len() {
    let mut j = 0;
    while j < want.byte_len() && hay.get(i + j).unwrap_or(0) == want.get(j).unwrap_or(1) {
      j = j + 1;
    }
    if j == want.byte_len() {
      return true;
    }
    i = i + 1;
  }
  return false;
}

fn head_end(buf: &Bytes) -> Int
  intent "Index of CRLF CRLF or -1."
  requires none
  ensures none
  effects none
{
  let mut i = 0;
  while i + 3 < buf.byte_len() {
    if buf.get(i).unwrap_or(0) == 13 && buf.get(i + 1).unwrap_or(0) == 10 && buf.get(i + 2).unwrap_or(0) == 13 && buf.get(i + 3).unwrap_or(0) == 10 {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn digits(bytes: &Bytes, start: Int) -> Int
  intent "Parse decimal digits from a position."
  requires none
  ensures none
  effects none
{
  let mut value = 0;
  let mut i = start;
  while i < bytes.byte_len() {
    let c = bytes.get(i).unwrap_or(0);
    if c < 48 || c > 57 {
      return value;
    }
    value = value * 10 + c - 48;
    i = i + 1;
  }
  return value;
}

fn content_length(head: &Bytes) -> Int
  intent "Read the Content-Length value of a response head."
  requires none
  ensures none
  effects none
{
  let marker = "Content-Length: ".as_bytes();
  let mut i = 0;
  while i + marker.byte_len() <= head.byte_len() {
    let mut j = 0;
    while j < marker.byte_len() && head.get(i + j).unwrap_or(0) == marker.get(j).unwrap_or(1) {
      j = j + 1;
    }
    if j == marker.byte_len() {
      return digits(&head, i + j);
    }
    i = i + 1;
  }
  return 0;
}

fn open(port: Int) -> Result<TcpClient, Int>
  intent "Connect to the server."
  requires none
  ensures none
  effects net.client, task.suspend
{
  return net.connect(&"127.0.0.1", port).map_err(|error| 9001);
}

fn read_reply(conn: &mut TcpClient, wait_ms: Int) -> Result<Reply, Int>
  intent "Read one HTTP response: head, then Content-Length bytes."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  let mut buf = Bytes.new();
  let mut end = head_end(&buf);
  while end < 0 {
    let got = task.timeout(wait_ms, || conn.read(4096));
    match got {
      None => {
        return Err(1);
      }
      Some(outcome) => {
        match outcome {
          Ok(piece) => {
            if piece.byte_len() == 0 {
              return Err(1);
            }
            buf.extend(&piece);
          }
          Err(error) => {
            return Err(1);
          }
        }
      }
    }
    end = head_end(&buf);
  }
  let head = buf.slice(0, end).unwrap_or(Bytes.new());
  let need = content_length(&head);
  let mut body = buf.slice(end + 4, buf.byte_len()).unwrap_or(Bytes.new());
  while body.byte_len() < need {
    let got = task.timeout(wait_ms, || conn.read(65536));
    match got {
      Some(Ok(piece)) => {
        if piece.byte_len() == 0 {
          return Err(1);
        }
        body.extend(&piece);
      }
      _ => {
        return Err(1);
      }
    }
  }
  return Ok(Reply { status: digits(&head, 9), body: body.to_string_utf8().unwrap_or("") });
}

fn send_all(conn: &mut TcpClient, data: &Bytes) -> Bool
  intent "Write all bytes within five seconds."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  return match task.timeout(5000, || conn.write_all(&data)) {
    Some(done) => done.is_ok(),
    None => false,
  };
}

fn request_bytes(method: &String, target: &String, body: &Bytes, close: Bool) -> Bytes
  intent "Build one HTTP/1.1 request."
  requires none
  ensures none
  effects none
{
  let mut out = method.as_bytes();
  out.push(32);
  out.extend(&target.as_bytes());
  out.extend(&" HTTP/1.1\r\nHost: 127.0.0.1\r\n".as_bytes());
  if close {
    out.extend(&"Connection: close\r\n".as_bytes());
  }
  out.extend(&"Content-Length: ".as_bytes());
  let mut length = Bytes.new();
  let mut nodes = List.new();
  nodes.push(JsonNode.Int(body.byte_len()));
  match json.stringify(&JsonValue.new(nodes, 0)) {
    Ok(text) => {
      length = text;
    }
    Err(code) => {}
  }
  out.extend(&length);
  out.extend(&"\r\n\r\n".as_bytes());
  out.extend(&body);
  return out;
}

fn http(port: Int, method: String, target: String, body: &Bytes) -> Result<Reply, Int>
  intent "One request on a fresh connection."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  let mut conn = open(port)?;
  if !send_all(&mut conn, &request_bytes(&method, &target, &body, true)) {
    return Err(9002);
  }
  return read_reply(&mut conn, 60000);
}

fn post(port: Int, text: &String) -> Result<Reply, Int>
  intent "POST /ingest."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  return http(port, "POST", "/ingest", &text.as_bytes());
}

fn get(port: Int, target: String) -> Result<Reply, Int>
  intent "GET a path."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  return http(port, "GET", target, &Bytes.new());
}

fn log_row(ts: &String, component: &String, level: &String, msg: &String) -> String
  intent "One NDJSON log row."
  requires none
  ensures none
  effects none
{
  let mut out = "{\"ts\":\"".as_bytes();
  out.extend(&ts.as_bytes());
  out.extend(&"\",\"component\":\"".as_bytes());
  out.extend(&component.as_bytes());
  out.extend(&"\",\"level\":\"".as_bytes());
  out.extend(&level.as_bytes());
  out.extend(&"\",\"msg\":\"".as_bytes());
  out.extend(&msg.as_bytes());
  out.extend(&"\"}".as_bytes());
  return out.to_string_utf8().unwrap_or("");
}

fn metric_row(ts: &String, component: &String, name: &String, kind: &String, value: &String) -> String
  intent "One NDJSON metric row."
  requires none
  ensures none
  effects none
{
  let mut out = "{\"ts\":\"".as_bytes();
  out.extend(&ts.as_bytes());
  out.extend(&"\",\"component\":\"".as_bytes());
  out.extend(&component.as_bytes());
  out.extend(&"\",\"name\":\"".as_bytes());
  out.extend(&name.as_bytes());
  out.extend(&"\",\"type\":\"".as_bytes());
  out.extend(&kind.as_bytes());
  out.extend(&"\",\"value\":".as_bytes());
  out.extend(&value.as_bytes());
  out.extend(&",\"labels\":{\"queue\":\"jobs\"}}".as_bytes());
  return out.to_string_utf8().unwrap_or("");
}

fn expect(reply: Result<Reply, Int>, status: Int, needle: &String, code: Int) -> Int
  intent "Check a reply's status and one body fragment; returns 0 or code."
  requires none
  ensures none
  effects none
{
  match reply {
    Ok(r) => {
      if r.status != status {
        return code * 10 + 1;
      }
      if needle.byte_len() > 0 && !has(&r.body, &needle) {
        return code * 10 + 2;
      }
      return 0;
    }
    Err(err) => {
      return code * 10 + 3;
    }
  }
}

// ---------------------------------------------------------------------------------------------------------------
// Scenarios

fn scenario_rotation(port: Int) -> Result<Int, Int>
  intent "Scenario 1: Capacity limit triggers FIFO rotation, dropping oldest logs to continue operating."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  // Post log 1
  let row1 = log_row(&"2026-11-27T10:00:01.000000Z", &"sigil-rotate", &"INFO", &"first log entry 11111111111111111111");
  let res1 = expect(post(port, &row1), 200, &"\"accepted\":1", 101);
  if res1 != 0 {
    return Err(res1);
  }

  // Post log 2
  let row2 = log_row(&"2026-11-27T10:00:02.000000Z", &"sigil-rotate", &"INFO", &"second log entry 222222222222222222");
  let res2 = expect(post(port, &row2), 200, &"\"accepted\":1", 102);
  if res2 != 0 {
    return Err(res2);
  }

  // Post log 3
  let row3 = log_row(&"2026-11-27T10:00:03.000000Z", &"sigil-rotate", &"INFO", &"third log entry 3333333333333333333");
  let res3 = expect(post(port, &row3), 200, &"\"accepted\":1", 103);
  if res3 != 0 {
    return Err(res3);
  }

  // Verify all 3 are currently present
  let q1 = get(port, "/api/logs?component=sigil-rotate");
  match q1 {
    Ok(reply) => {
      if reply.status != 200 || !has(&reply.body, &"first log entry") || !has(&reply.body, &"third log entry") {
        return Err(104);
      }
    }
    Err(e) => {
      return Err(105);
    }
  }

  // Now post log 4: pushes stored_bytes (489 bytes) over 400 bytes capacity limit.
  // Capacity FIFO rotation drops oldest (log 1: "first log entry").
  let row4 = log_row(&"2026-11-27T10:00:04.000000Z", &"sigil-rotate", &"INFO", &"fourth log entry 444444444444444444");
  let res4 = expect(post(port, &row4), 200, &"\"accepted\":1", 106);
  if res4 != 0 {
    return Err(res4);
  }

  // Query /api/logs: oldest log 1 dropped, newest log 4 present!
  let q2 = get(port, "/api/logs?component=sigil-rotate");
  match q2 {
    Ok(reply) => {
      if reply.status != 200 {
        return Err(107);
      }
      if has(&reply.body, &"first log entry") {
        return Err(108);  // Oldest log should have been rotated out
      }
      if !has(&reply.body, &"fourth log entry") || !has(&reply.body, &"third log entry") || !has(&reply.body, &"second log entry") {
        return Err(109);
      }
    }
    Err(e) => {
      return Err(110);
    }
  }
  return Ok(0);
}

fn scenario_retention(port: Int, cell: Atomic<Int>) -> Result<Int, Int>
  intent "Scenario 2: Logs exceeding retention period are dropped."
  requires none
  ensures none
  effects clock, net.client, task
{
  // Timestamp at 1000000 ms = 1970-01-01T00:16:40.000000Z
  let row_old = log_row(&"1970-01-01T00:16:40.000000Z", &"sigil-retention", &"INFO", &"old record to expire");
  let res1 = expect(post(port, &row_old), 200, &"\"accepted\":1", 201);
  if res1 != 0 {
    return Err(res1);
  }

  // Advance clock by 10 seconds (10000 ms) > retention limit of 5000 ms
  cell.store(1010000);

  // Post new record at 1970-01-01T00:16:50.000000Z
  let row_new = log_row(&"1970-01-01T00:16:50.000000Z", &"sigil-retention", &"INFO", &"fresh new record");
  let res2 = expect(post(port, &row_new), 200, &"\"accepted\":1", 202);
  if res2 != 0 {
    return Err(res2);
  }

  // Query: old record was pruned by retention, only fresh record remains
  let q = get(port, "/api/logs?component=sigil-retention");
  match q {
    Ok(reply) => {
      if reply.status != 200 {
        return Err(203);
      }
      if has(&reply.body, &"old record to expire") {
        return Err(204);  // Should have been expired
      }
      if !has(&reply.body, &"fresh new record") {
        return Err(205);
      }
    }
    Err(e) => {
      return Err(206);
    }
  }
  return Ok(0);
}

fn scenario_rate_limit_http(port: Int, cell: Atomic<Int>) -> Result<Int, Int>
  intent "Scenario 3: High-frequency HTTP ingest is rejected with 429 Too Many Requests, recovers on next window."
  requires none
  ensures none
  effects clock, net.client, task
{
  // Ingest 3 logs (within max_rate limit of 3)
  let mut rows = Bytes.new();
  rows.extend(&log_row(&"2026-11-27T11:00:01.000000Z", &"sigil-rate", &"INFO", &"rate log 1").as_bytes());
  rows.push(10);
  rows.extend(&log_row(&"2026-11-27T11:00:02.000000Z", &"sigil-rate", &"INFO", &"rate log 2").as_bytes());
  rows.push(10);
  rows.extend(&log_row(&"2026-11-27T11:00:03.000000Z", &"sigil-rate", &"INFO", &"rate log 3").as_bytes());
  rows.push(10);

  let ok1 = expect(http(port, "POST", "/ingest", &rows), 200, &"\"accepted\":3", 301);
  if ok1 != 0 {
    return Err(ok1);
  }

  // 4th log within same 1-second window exceeds rate limit -> 429 Too Many Requests
  let row4 = log_row(&"2026-11-27T11:00:04.000000Z", &"sigil-rate", &"INFO", &"rate log 4");
  let limited = expect(post(port, &row4), 429, &"rate_limited", 302);
  if limited != 0 {
    return Err(limited);
  }

  // Advance clock by 1000 ms to open new window
  cell.store(cell.load() + 1000);

  // Ingest succeeds again in new window
  let row5 = log_row(&"2026-11-27T11:00:05.000000Z", &"sigil-rate", &"INFO", &"rate log 5");
  let ok2 = expect(post(port, &row5), 200, &"\"accepted\":1", 303);
  if ok2 != 0 {
    return Err(ok2);
  }
  return Ok(0);
}

fn read_line(conn: &mut TcpClient) -> Result<String, Int>
  intent "Read until newline or error."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  let mut buf = Bytes.new();
  while true {
    let mut i = 0;
    while i < buf.byte_len() {
      if buf.get(i).unwrap_or(0) == 10 {
        return Ok(buf.to_string_utf8().unwrap_or(""));
      }
      i = i + 1;
    }
    match task.timeout(60000, || conn.read(256)) {
      Some(Ok(piece)) => {
        if piece.byte_len() == 0 {
          return Err(1);
        }
        buf.extend(&piece);
      }
      _ => {
        return Err(2);
      }
    }
  }
  return Err(2);
}

fn scenario_rate_limit_tcp(port: Int, cell: Atomic<Int>) -> Result<Int, Int>
  intent "Scenario 4: Raw TCP stream exceeding rate limit receives ERR rate_limited, recovers on next window."
  requires none
  ensures none
  effects clock, net.client, task
{
  let mut conn = open(port)?;
  let line1 = log_row(&"2026-11-27T12:00:01.000000Z", &"sigil-tcp-rate", &"INFO", &"tcp row 1");
  let mut buf1 = line1.as_bytes();
  buf1.push(10);
  if !send_all(&mut conn, &buf1) {
    return Err(401);
  }
  let mut rep1 = "";
  match read_line(&mut conn) {
    Ok(s) => {
      rep1 = s;
    }
    Err(e) => {
      return Err(402);
    }
  }
  if rep1 != "OK\n" {
    return Err(403);
  }

  // Line 2: still within limit 2
  let line2 = log_row(&"2026-11-27T12:00:02.000000Z", &"sigil-tcp-rate", &"INFO", &"tcp row 2");
  let mut buf2 = line2.as_bytes();
  buf2.push(10);
  if !send_all(&mut conn, &buf2) {
    return Err(404);
  }
  let mut rep2 = "";
  match read_line(&mut conn) {
    Ok(s) => {
      rep2 = s;
    }
    Err(e) => {
      return Err(405);
    }
  }
  if rep2 != "OK\n" {
    return Err(406);
  }

  // Line 3: exceeds rate limit 2 -> receives ERR rate_limited\n
  let line3 = log_row(&"2026-11-27T12:00:03.000000Z", &"sigil-tcp-rate", &"INFO", &"tcp row 3");
  let mut buf3 = line3.as_bytes();
  buf3.push(10);
  if !send_all(&mut conn, &buf3) {
    return Err(407);
  }
  let mut rep3 = "";
  match read_line(&mut conn) {
    Ok(s) => {
      rep3 = s;
    }
    Err(e) => {
      return Err(408);
    }
  }
  if rep3 != "ERR rate_limited\n" {
    return Err(409);
  }

  // Advance clock by 1000 ms to open new window
  cell.store(cell.load() + 1000);

  // Line 4 succeeds in new window
  let line4 = log_row(&"2026-11-27T12:00:04.000000Z", &"sigil-tcp-rate", &"INFO", &"tcp row 4");
  let mut buf4 = line4.as_bytes();
  buf4.push(10);
  if !send_all(&mut conn, &buf4) {
    return Err(410);
  }
  let mut rep4 = "";
  match read_line(&mut conn) {
    Ok(s) => {
      rep4 = s;
    }
    Err(e) => {
      return Err(411);
    }
  }
  if rep4 != "OK\n" {
    return Err(412);
  }
  return Ok(0);
}

fn scenario_load_boundaries(port: Int) -> Result<Int, Int>
  intent "Scenario 5: Load boundaries: scan_limit complete:false, query_max clamping, 413, 431, and line length limits."
  requires none
  ensures none
  effects clock, net.client, task.spawn, task.suspend
{
  // A. Ingest 6 metric samples
  let mut mrows = Bytes.new();
  let mut i = 0;
  while i < 6 {
    let mut ts = "2026-11-27T13:00:0".as_bytes();
    ts.push(48 + i);
    ts.extend(&".000000Z".as_bytes());
    mrows.extend(&metric_row(&ts.to_string_utf8().unwrap_or(""), &"sigil-boundary", &"cpu_load", &"gauge", &"42.0").as_bytes());
    mrows.push(10);
    i = i + 1;
  }
  let mres = expect(http(port, "POST", "/ingest", &mrows), 200, &"\"accepted\":6", 501);
  if mres != 0 {
    return Err(mres);
  }

  // Query metrics: scan_limit is 4 (< 6 stored samples) -> returns complete:false and scanned:4
  let mq = get(port, "/api/metrics?component=sigil-boundary&name=cpu_load");
  match mq {
    Ok(reply) => {
      if reply.status != 200 {
        return Err(502);
      }
      if !has(&reply.body, &"\"scanned\":4") || !has(&reply.body, &"\"complete\":false") {
        return Err(503);
      }
    }
    Err(e) => {
      return Err(504);
    }
  }

  // B. Ingest 6 logs, query with large limit -> clamped to query_max (3)
  let mut lrows = Bytes.new();
  let mut j = 0;
  while j < 6 {
    let mut ts = "2026-11-27T13:00:0".as_bytes();
    ts.push(48 + j);
    ts.extend(&".000000Z".as_bytes());
    lrows.extend(&log_row(&ts.to_string_utf8().unwrap_or(""), &"sigil-boundary", &"INFO", &"clamp test").as_bytes());
    lrows.push(10);
    j = j + 1;
  }
  let lres = expect(http(port, "POST", "/ingest", &lrows), 200, &"\"accepted\":6", 505);
  if lres != 0 {
    return Err(lres);
  }

  let lq = get(port, "/api/logs?component=sigil-boundary&limit=1000");
  match lq {
    Ok(reply) => {
      if reply.status != 200 || !has(&reply.body, &"\"count\":3") {
        return Err(506);
      }
    }
    Err(e) => {
      return Err(507);
    }
  }

  // C. Max body size: 2500 bytes body exceeds max_body_bytes (2000) -> 413 Payload Too Large
  let mut big_body = Bytes.new();
  while big_body.byte_len() < 2500 {
    big_body.push(65);
  }
  let big_reply = http(port, "POST", "/ingest", &big_body);
  match big_reply {
    Ok(reply) => {
      if reply.status != 413 {
        return Err(508);
      }
    }
    Err(e) => {
      return Err(509);
    }
  }

  // D. Max head size: header > 8192 bytes -> 431 Request Header Fields Too Large
  let mut conn = open(port)?;
  let mut big_head = "GET /healthz HTTP/1.1\r\nHost: 127.0.0.1\r\nX-Long: ".as_bytes();
  while big_head.byte_len() < 9000 {
    big_head.push(88);
  }
  big_head.extend(&"\r\n\r\n".as_bytes());
  if !send_all(&mut conn, &big_head) {
    return Err(510);
  }
  match read_reply(&mut conn, 60000) {
    Ok(reply) => {
      if reply.status != 431 {
        return Err(511);
      }
    }
    Err(e) => {
      return Err(512);
    }
  }

  // E. Raw TCP line over 64 KB -> ERR line_too_large and close
  let mut raw_conn = open(port)?;
  let mut big_line = "{\"ts\":\"2026-11-27T13:00:00.000000Z\",\"component\":\"sigil-boundary\",\"level\":\"INFO\",\"msg\":\"".as_bytes();
  while big_line.byte_len() < 66000 {
    big_line.push(90);
  }
  big_line.extend(&"\"}\n".as_bytes());
  let _ = task.timeout(60000, || raw_conn.write_all(&big_line));
  let mut raw_rep = Bytes.new();
  while !has(&raw_rep.to_string_utf8().unwrap_or(""), &"ERR line_too_large") {
    match task.timeout(60000, || raw_conn.read(64)) {
      Some(Ok(piece)) => {
        if piece.byte_len() == 0 {
          return Err(513);
        }
        raw_rep.extend(&piece);
      }
      _ => {
        return Err(513);
      }
    }
  }
  if !has(&raw_rep.to_string_utf8().unwrap_or(""), &"ERR line_too_large") {
    return Err(513);
  }

  return Ok(0);
}

// ---------------------------------------------------------------------------------------------------------------
// Harness and Runner

fn db_path(which: Int) -> String
  intent "A per-scenario database path under ARGUS_TEST_DB."
  requires none
  ensures none
  effects env
{
  let base = env.get(&"ARGUS_TEST_DB").unwrap_or("");
  if base == "" {
    return "";
  }
  let mut path = base.as_bytes();
  path.extend(&"-stage4-".as_bytes());
  path.push(48 + which);
  return path.to_string_utf8().unwrap_or("");
}

fn harness(which: Int) -> Int
  intent "Configure server according to scenario, run scenario against it, return code."
  requires none
  ensures none
  effects clock, env, fs, net.server, task
{
  let path = db_path(which);
  if path == "" {
    return 8003;
  }
  let cell = Atomic.new(1000000);
  let mut config = with_listen(default_config(path), "127.0.0.1", 0);

  if which == 1 {
    // Scenario 1: capacity 400 bytes, no retention expiry
    config = with_retention(config, 0, 400);
  } else if which == 2 {
    // Scenario 2: retention 5000 ms, no capacity limit
    config = with_test_clock(with_retention(config, 5000, 0), cell.clone());
  } else if which == 3 {
    // Scenario 3: HTTP rate limit 3/sec
    config = with_test_clock(with_rate_limit(config, 3), cell.clone());
  } else if which == 4 {
    // Scenario 4: TCP rate limit 2/sec
    config = with_test_clock(with_rate_limit(config, 2), cell.clone());
  } else if which == 5 {
    // Scenario 5: load boundaries: query_max 3, scan_limit 4, max_body 2000
    config = with_limits(with_query_limits(config, 3, 4), 64, 5000, 2000, 1000);
  }

  match open_hub(config) {
    Ok(hub) => {
      match listen_on(&hub.config) {
        Ok(listener) => {
          let port = listener.local_port();
          let shared = share_hub(hub);
          let mut gs = List.new();
          if which == 1 {
            gs.push(move || match scenario_rotation(port) {
              Ok(c) => c,
              Err(c) => c,
            });
          } else if which == 2 {
            let c2 = cell.clone();
            gs.push(move || match scenario_retention(port, c2.clone()) {
              Ok(c) => c,
              Err(c) => c,
            });
          } else if which == 3 {
            let c3 = cell.clone();
            gs.push(move || match scenario_rate_limit_http(port, c3.clone()) {
              Ok(c) => c,
              Err(c) => c,
            });
          } else if which == 4 {
            let c4 = cell.clone();
            gs.push(move || match scenario_rate_limit_tcp(port, c4.clone()) {
              Ok(c) => c,
              Err(c) => c,
            });
          } else {
            gs.push(move || match scenario_load_boundaries(port) {
              Ok(c) => c,
              Err(c) => c,
            });
          }
          gs.push(move || serve(&listener, &shared));
          return task.race(gs);
        }
        Err(error) => {
          return 8001;
        }
      }
    }
    Err(error) => {
      return 8002;
    }
  }
}

pub fn main() -> Int
  intent "Run all Stage 4 scenarios and return 0 on success, or first failing scenario code."
  requires none
  ensures none
  effects clock, env, fs, net.server, task
{
  let mut which = 1;
  while which <= 5 {
    let outcome = harness(which);
    if outcome != 0 {
      return which * 1000 + outcome;
    }
    which = which + 1;
  }
  return 0;
}
